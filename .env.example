# Copy to .env and adjust. Every value is optional.

# Address on the host the port is published on. 127.0.0.1 keeps Yarrow private
# to the machine (use Tailscale Serve to reach it); 0.0.0.0 opens it on your LAN.
YARROW_BIND=127.0.0.1
YARROW_PORT=7070

# Timezone for logs.
TZ=UTC

# Require a login. Strongly recommended if YARROW_BIND is not 127.0.0.1.
# Format: username:password
YARR_AUTH=

# Serve under a sub-path behind a reverse proxy, e.g. /rss
YARR_BASE=

# Feeds on private networks are blocked to prevent SSRF. Allow specific ranges
# if you subscribe to something on your LAN, e.g. 192.168.1.0/24
YARR_ALLOWED_NETWORKS=

# Tag for the locally built image.
YARROW_VERSION=local
